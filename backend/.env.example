# Database connection string (PostgreSQL with psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:5432/<database_name>

# JWT signing secret key (generate with: openssl rand -hex 32)
SECRET_KEY=<your-secret-key>

# Allowed CORS origins (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:5173
